# Server Environment
PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# ========================================================
# KREDENSIAL MASTER SUPERADMIN (ENVIRONMENT VARIABLES)
# ========================================================
# 1. SUPERADMIN_EMAIL: Email resmi untuk login Superadmin
SUPERADMIN_EMAIL=presensiapp138@gmail.com

# 2. SUPERADMIN_PASSWORD_HASH: Hash bcrypt dari kata sandi Superadmin
# JANGAN SIMPAN SANDI POLOS DI SINI! Gunakan hash bcrypt.
# Contoh membuat hash bcrypt dengan Node.js:
# node -e "console.log(require('bcryptjs').hashSync('SandiSuperAnda123!', 10))"
# Hash bawaan di bawah ini adalah hash untuk 'superadmin123':
SUPERADMIN_PASSWORD_HASH=$2b$10$cxNkIe1PEHakuWAten6hY.ELzh5GmDWUxeEAfboC7u7sUx80HJ0tG

# 3. JWT_SECRET: Kunci rahasia untuk tanda tangan sesi JWT Superadmin
JWT_SECRET=superadmin-secret-key-presensi-2026-secure-jwt

# Google Workspace / Gemini API (Opsional)
GEMINI_API_KEY=
